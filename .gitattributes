# Normalize text files to LF in the repo, checked out as CRLF on Windows -
# stops every commit from re-triggering "LF will be replaced by CRLF"
# warnings for files git already has committed with mixed endings.
* text=auto

# windows_terminal_settings.json is compared byte-for-byte (SHA256) against
# the live Windows Terminal settings.json at runtime to decide "installed"
# vs "not installed" — git's default autocrlf on Windows would silently
# convert its LF line endings to CRLF on checkout, breaking that
# comparison for anyone who clones this repo. Treated as binary so git
# never touches it.
assets/windows_terminal_settings.json -text
